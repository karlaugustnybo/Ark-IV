{
  "$schema": "./frontend/node_modules/oxfmt/configuration_schema.json",
  "singleQuote": true,
  "trailingComma": "none",
  "printWidth": 100,
  "sortImports": false,
  "sortPackageJson": false,
  "svelte": { "sortOrder": "none" },
  "ignorePatterns": [
    "**/node_modules/**",
    "frontend/.svelte-kit/**",
    "frontend/build/**",
    "frontend/bun.lock",
    "frontend/src/lib/api/schema.d.ts"
  ]
}
